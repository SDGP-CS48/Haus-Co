# Haus & Co Environment Configuration (Example — Do NOT put real secrets here)
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-strong-32-char-secret-in-production
DEMO_MODE=true

# Database (PostgreSQL in production; local SQLite fallback when unset in demo/dev)
DATABASE_URL=postgresql://hausco:hausco_dev@localhost:5432/hausco
SQLITE_PATH=./backend/data/hausco-demo.sqlite

# Object Storage (Private S3-compatible bucket for blueprints, land surveys, reports)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hausco-private-docs
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_REGION=ap-southeast-1

# Sri Lankan Phone OTP Providers (Dialog / Mobitel SMS Gateway)
OTP_PROVIDER=demo
DIALOG_SMS_API_URL=https://api.dialog.lk/sms/v1
DIALOG_SMS_API_KEY=
MOBITEL_SMS_API_URL=https://api.mobitel.lk/sms/v1
MOBITEL_SMS_API_KEY=

# PayHere Payment Gateway
PAYHERE_MODE=demo
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=https://api.hausandco.lk/api/v1/payments/payhere/notify

# WebRTC Consultation Signaling / TURN
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USER=
WEBRTC_TURN_CREDENTIAL=

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_DEMO_MODE=true
